# ===== Milvus =====
# Docker Milvus:
MILVUS_URI=http://localhost:19530
# Milvus Lite:
# MILVUS_URI=./milvus_llamaindex.db
MILVUS_TOKEN=
MILVUS_COLLECTION=document_kb
MILVUS_OVERWRITE=false

# Qwen3-Embedding-4B default max dimension is 2560
EMBED_MODEL_NAME=Qwen/Qwen3-Embedding-4B
EMBED_DIM=2560
EMBED_DEVICE=auto
EMBED_BATCH_SIZE=2
EMBED_MAX_LENGTH=8192

# ===== LLM =====
DASHSCOPE_API_KEY=xxxxxx
DASHSCOPE_BASIC_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MAX_TOKENS=1024
QWEN_LLM_MODEL=qwen-max

QWEN3_RERANKER_MODEL=D:\models\Qwen3-Reranker-4b

KIMI_LLM_MODEL=kimi-k2.6
KIMI_API_KEY=xxxx
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MAX_TOKENS=1024


# ===== RAG =====
CHUNK_SIZE=800
CHUNK_OVERLAP=120
SIMILARITY_TOP_K=10

# ===== NEO4J =====
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j